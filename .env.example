# =============================================================================
# BrainTrack App - Environment Variables Configuration
# =============================================================================
# Copy this file to .env and replace the example values with your actual values
# IMPORTANT: Never commit .env files to version control!

# -----------------------------------------------------------------------------
# Database Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# Example for Railway: postgresql://postgres:password@containers-us-west-xxx.railway.app:5432/railway
# Example for local: postgresql://postgres:postgres@localhost:5432/braintrack
DATABASE_URL=postgresql://username:password@localhost:5432/braintrack

# -----------------------------------------------------------------------------
# Session Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Secret key for session encryption - MUST be a strong random string in production
# Generate a secure secret with: openssl rand -base64 32
# Or use: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=change-this-to-a-secure-random-string-in-production

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Node environment (development, production, or test)
NODE_ENV=development

# Server port (default: 5000)
# Note: The application is configured to run on port 5000
PORT=5000

# -----------------------------------------------------------------------------
# Security Notes
# -----------------------------------------------------------------------------
# 1. DATABASE_URL: Keep this secret! It contains database credentials
# 2. SESSION_SECRET: Use a cryptographically secure random string (min 32 chars)
# 3. In production, ensure all secrets are stored in your hosting platform's
#    environment variable system (Railway, Heroku, etc.) - NOT in .env files
# 4. Rotate SESSION_SECRET periodically for better security
# 5. Use SSL/TLS in production for database connections

# -----------------------------------------------------------------------------
# Optional Configuration (for future features)
# -----------------------------------------------------------------------------
# These are not currently used but reserved for future enhancements

# CORS allowed origins (comma-separated, for production)
# CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Rate limiting configuration
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# Logging level (error, warn, info, debug)
# LOG_LEVEL=info

# File upload limits (in MB)
# MAX_UPLOAD_SIZE=50

# External AI service API keys (if integrating external services in future)
# OPENAI_API_KEY=your-openai-api-key-here
# TENSORFLOW_SERVING_URL=http://localhost:8501/v1/models
